{
  "name": "sshbuddy",
  "productName": "SSHBuddy",
  "version": "0.1.0",
  "description": "Cross-platform SSH client with SFTP, live host stats and Proton Pass integration",
  "homepage": "https://sshbuddy.invalid",
  "main": "./out/main/index.js",
  "author": "SSHBuddy",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "dist": "electron-vite build && electron-builder",
    "dist:linux": "electron-vite build && electron-builder --linux",
    "dist:win": "electron-vite build && electron-builder --win",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "test:it": "scripts/it-server.sh >/dev/null && SSHBUDDY_IT_JUMP=1 SSHBUDDY_IT_KEYDIR=${SSHBUDDY_IT_KEYDIR:-$PWD/test/.data} vitest run test/ssh.integration.test.ts",
    "test:smoke": "electron-vite build && SMOKE_JUMP=1 SMOKE_KEY=${SSHBUDDY_IT_KEYDIR:-$PWD/test/.data}/id_plain electron --ozone-platform=headless scripts/smoke.cjs",
    "icon": "electron --ozone-platform=headless scripts/make-icon.cjs",
    "dist:dir": "electron-vite build && electron-builder --dir",
    "dist:all": "npm run dist:linux && npm run dist:win:docker",
    "dist:win:portable": "electron-vite build && electron-builder --win portable",
    "dist:win:docker": "scripts/build-win.sh"
  },
  "dependencies": {
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ssh2": "^1.15.6",
    "@vitejs/plugin-react": "^6.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "zustand": "^5.1.0"
  },
  "desktopName": "sshbuddy.desktop"
}
